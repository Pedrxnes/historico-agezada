[Unit]
Description=Sincroniza partidas do aoe4world
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aoe4
WorkingDirectory=/opt/aoe4stats/backend
Environment=AOE4_DB=/opt/aoe4stats/data/aoe4.db
Environment=AOE4_CONFIG=/opt/aoe4stats/players.json
ExecStart=/opt/aoe4stats/.venv/bin/python sync.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aoe4stats/data
